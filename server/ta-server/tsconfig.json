{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [ "es2015", "dom" ],
    "noImplicitAny": true,
    "outDir": "typeScript",
    "suppressImplicitAnyIndexErrors": true,
    "skipLibCheck": true,
    "typeRoots": ["./typings", "./node_modules/@types"]
  },
  "compileOnSave": true,
}

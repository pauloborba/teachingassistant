{
  "name": "ta-gui-tests",
  "version": "1.0.0",
  "description": "Testes E2E com Cucumber e Playwright (compatível com Node 16)",
  "scripts": {
    "teste": "npm run teste:compact",
    "teste:watch": "cucumber-js --publish-quiet",
    "teste:report": "cucumber-js --format json:reports/report.json",
    "teste:json": "cucumber-js --format json:reports/cucumber.json --require \"steps/*.ts\" --require-module ts-node/register 'features/**/*.feature'",
    "teste:compact": "npm run teste:json && node scripts/summary.js",
    "test": "npm run teste"
  },
  "dependencies": {
    "@cucumber/cucumber": "^9.0.0",
    "playwright": "1.36.0",
    "@playwright/test": "1.36.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "chai": "^4.3.7"
    ,"node-fetch": "2.6.7"
  }
}